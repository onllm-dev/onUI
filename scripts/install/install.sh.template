#!/usr/bin/env bash
set -euo pipefail

VERSION="__VERSION__"
REPO="onllm-dev/onUI"
BASE_URL="${ONUI_RELEASE_BASE_URL:-https://github.com/${REPO}}"
ONUI_HOME="${ONUI_HOME:-$HOME/onUI}"
EXT_ROOT="${ONUI_HOME}/extensions"
EXT_DIR="${EXT_ROOT}/v${VERSION}"
CURRENT_LINK="${EXT_ROOT}/current"
CHROMIUM_EXT_URL="${BASE_URL}/releases/download/v${VERSION}/onui-extension-unpacked-v${VERSION}.zip"
FIREFOX_EXT_URL="${BASE_URL}/releases/download/v${VERSION}/onui-firefox-add-ons-v${VERSION}.zip"
MCP_URL="${BASE_URL}/releases/download/v${VERSION}/onui-mcp-bundle-v${VERSION}.zip"
MCP_DIR="${ONUI_HOME}/mcp/v${VERSION}"

INSTALL_MCP=0
BROWSER_TARGET="${ONUI_BROWSER_TARGET:-chromium}"

log() {
  printf '[onui-install] %s\n' "$1"
}

fail() {
  printf '[onui-install] ERROR: %s\n' "$1" >&2
  exit 1
}

warn() {
  printf '[onui-install] WARN: %s\n' "$1" >&2
}

print_node_install_help() {
  warn "Install Node 20+ and rerun this installer."
  case "$(uname -s)" in
    Darwin)
      printf 'Install command (macOS): brew install node@20 && brew link --force --overwrite node@20\n' >&2
      ;;
    Linux)
      if command -v apt-get >/dev/null 2>&1; then
        printf 'Install command (Ubuntu/Debian): sudo apt-get update && sudo apt-get install -y nodejs npm\n' >&2
      elif command -v dnf >/dev/null 2>&1; then
        printf 'Install command (Fedora/RHEL): sudo dnf install -y nodejs npm\n' >&2
      elif command -v yum >/dev/null 2>&1; then
        printf 'Install command (RHEL/CentOS): sudo yum install -y nodejs npm\n' >&2
      elif command -v pacman >/dev/null 2>&1; then
        printf 'Install command (Arch): sudo pacman -S --noconfirm nodejs npm\n' >&2
      elif command -v apk >/dev/null 2>&1; then
        printf 'Install command (Alpine): sudo apk add --no-cache nodejs npm\n' >&2
      else
        printf 'Install Node 20+ from: https://nodejs.org/en/download\n' >&2
      fi
      ;;
    *)
      printf 'Install Node 20+ from: https://nodejs.org/en/download\n' >&2
      ;;
  esac
  printf 'After installation, open a new terminal shell and rerun this installer command.\n' >&2
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "Missing required command: $1"
}

open_browser_extensions() {
  if [ "$BROWSER_TARGET" = "firefox" ]; then
    if command -v firefox >/dev/null 2>&1; then
      firefox "about:debugging#/runtime/this-firefox" >/dev/null 2>&1 &
      return
    fi
    if command -v open >/dev/null 2>&1; then
      open -a "Firefox" "about:debugging#/runtime/this-firefox" >/dev/null 2>&1 && return
      open "about:debugging#/runtime/this-firefox" >/dev/null 2>&1 || true
      return
    fi
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "about:debugging#/runtime/this-firefox" >/dev/null 2>&1 || true
    fi
    return
  fi

  if command -v microsoft-edge >/dev/null 2>&1; then
    microsoft-edge "edge://extensions" >/dev/null 2>&1 &
    return
  fi
  if command -v microsoft-edge-stable >/dev/null 2>&1; then
    microsoft-edge-stable "edge://extensions" >/dev/null 2>&1 &
    return
  fi
  if command -v google-chrome >/dev/null 2>&1; then
    google-chrome "chrome://extensions" >/dev/null 2>&1 &
    return
  fi
  if command -v open >/dev/null 2>&1; then
    open -a "Microsoft Edge" "edge://extensions" >/dev/null 2>&1 && return
    open -a "Google Chrome" "chrome://extensions" >/dev/null 2>&1 && return
    open "edge://extensions" >/dev/null 2>&1 && return
    open "chrome://extensions" >/dev/null 2>&1 || true
    return
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "edge://extensions" >/dev/null 2>&1 || xdg-open "chrome://extensions" >/dev/null 2>&1 || true
  fi
}

usage() {
  cat <<'EOF'
Usage:
  install.sh [--mcp] [--firefox] [--chromium] [--help]

Options:
  --mcp       Also run local MCP setup.
  --firefox   Install Firefox-compatible extension artifact.
  --chromium  Install Chromium-compatible extension artifact (default).
  --help      Show this help.
EOF
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --mcp)
        INSTALL_MCP=1
        ;;
      --firefox)
        BROWSER_TARGET="firefox"
        ;;
      --chromium)
        BROWSER_TARGET="chromium"
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        fail "Unknown option: $1"
        ;;
    esac
    shift
  done
}

install_extension() {
  require_cmd curl
  require_cmd unzip

  mkdir -p "$EXT_ROOT"
  local tmp_zip
  local ext_url
  tmp_zip="$(mktemp)"

  if [ "$BROWSER_TARGET" = "firefox" ]; then
    ext_url="$FIREFOX_EXT_URL"
  else
    ext_url="$CHROMIUM_EXT_URL"
  fi

  log "Downloading ${BROWSER_TARGET} extension release artifact v${VERSION}"
  curl -fsSL "$ext_url" -o "$tmp_zip"

  log "Installing extension files to $EXT_DIR"
  rm -rf "$EXT_DIR"
  mkdir -p "$EXT_DIR"
  unzip -oq "$tmp_zip" -d "$EXT_DIR"
  rm -f "$tmp_zip"

  ln -sfn "$EXT_DIR" "$CURRENT_LINK"

  log "Extension installed."
  printf 'Load unpacked path: %s\n' "$CURRENT_LINK"
}

prompt_for_mcp() {
  if [ "$INSTALL_MCP" -eq 1 ]; then
    return
  fi

  local answer=""
  if [ -r /dev/tty ]; then
    printf 'Set up local MCP bridge now? [y/N]: ' > /dev/tty
    IFS= read -r answer < /dev/tty || true
  elif [ -t 0 ]; then
    printf 'Set up local MCP bridge now? [y/N]: '
    IFS= read -r answer || true
  else
    log "Non-interactive mode detected; skipping MCP setup by default."
    return
  fi

  case "$answer" in
    y|Y|yes|YES)
      INSTALL_MCP=1
      ;;
    *)
      INSTALL_MCP=0
      ;;
  esac
}

install_mcp() {
  [ "$INSTALL_MCP" -eq 1 ] || return 0

  if ! command -v node >/dev/null 2>&1; then
    warn "Node is required for MCP setup but is not installed."
    print_node_install_help
    return 0
  fi

  require_cmd curl
  require_cmd unzip

  local node_major
  node_major="$(node -p "process.versions.node.split('.')[0]")"
  if [ "$node_major" -lt 20 ]; then
    warn "Node 20+ required for MCP setup. Found $(node -v)."
    print_node_install_help
    return 0
  fi

  local tmp_zip
  tmp_zip="$(mktemp)"

  log "Downloading prebuilt MCP bundle v${VERSION}"
  if ! curl -fsSL "$MCP_URL" -o "$tmp_zip"; then
    warn "Could not download MCP bundle for v${VERSION}. Skipping MCP setup."
    return 0
  fi

  rm -rf "$MCP_DIR"
  mkdir -p "$MCP_DIR"
  if ! unzip -oq "$tmp_zip" -d "$MCP_DIR"; then
    warn "Could not extract MCP bundle. Skipping MCP setup."
    rm -f "$tmp_zip"
    return 0
  fi
  rm -f "$tmp_zip"

  log "Running MCP setup"
  local cli_path="$MCP_DIR/dist/bin/onui-cli.js"
  if [ ! -f "$cli_path" ]; then
    warn "MCP CLI not found in bundle. Skipping MCP setup."
    return 0
  fi

  if ! node "$cli_path" setup; then
    warn "MCP setup failed. Extension install is complete; run MCP setup manually later."
    return 0
  fi

  local doctor_report
  doctor_report="$(node "$cli_path" doctor --json 2>/dev/null || true)"

  local doctor_status
  doctor_status="$(printf '%s\n' "$doctor_report" | node -e '
    const fs = require("node:fs");
    const text = fs.readFileSync(0, "utf8").trim();
    try {
      const report = JSON.parse(text);
      process.stdout.write(String(report.status || "unknown"));
    } catch {
      process.stdout.write("unknown");
    }
  ')"

  if [ "$doctor_status" = "error" ]; then
    warn "MCP doctor reported errors. Extension install is complete; rerun MCP doctor manually later."
    return 0
  fi

  if [ "$doctor_status" = "warning" ]; then
    warn "MCP doctor reported warnings (non-fatal)."
  fi

  log "MCP setup complete."
}

print_final_steps() {
  printf '\nFinal browser step (still required):\n'
  if [ "$BROWSER_TARGET" = "firefox" ]; then
    printf '1) Open about:debugging#/runtime/this-firefox\n'
    printf '2) Click Load Temporary Add-on...\n'
    printf '3) Select: %s\n' "$CURRENT_LINK/manifest.json"
  else
    printf '1) Open edge://extensions or chrome://extensions\n'
    printf '2) Enable Developer mode\n'
    printf '3) Click Load unpacked\n'
    printf '4) Select: %s\n' "$CURRENT_LINK"
  fi
  printf '\n'
  open_browser_extensions
}

main() {
  parse_args "$@"
  install_extension
  prompt_for_mcp
  install_mcp
  print_final_steps
}

main "$@"
